# Copy to .env (ignored by Git) and fill in. Never commit real values.
# So far only scripts/smoke_clickhouse.py reads these; the application uses them from M2.

# ClickHouse Cloud: bare hostname (no https://), HTTPS port 8443.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=mcp_trust_monitor

# Senso: org API key (X-API-Key). The policy content id is produced by uploading
# policies/demo-policy.json (POST /org/kb/raw returns it as `id`).
SENSO_API_KEY=
SENSO_POLICY_CONTENT_IDS=

# Model: Anthropic API key, read by the official anthropic SDK.
ANTHROPIC_API_KEY=
MODEL_NAME=claude-opus-5-5
